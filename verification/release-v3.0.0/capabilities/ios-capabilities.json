{
  "api_version": 2,
  "target": "ios",
  "screen": {
    "width": 1024,
    "height": 768
  },
  "commands": {
    "app.close": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-zA-Z0-9_.-]+$"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "app.deeplink": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    },
    "app.launch": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-zA-Z0-9_.-]+$"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "app.metrics": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-zA-Z0-9_.-]+$"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "app.restart": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-zA-Z0-9_.-]+$"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "app.uninstall": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-zA-Z0-9_.-]+$"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "clipboard.get": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "clipboard.set": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 8192
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "device.rotate": {
      "type": "object",
      "properties": {
        "direction": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ]
        }
      },
      "required": [
        "direction"
      ],
      "additionalProperties": false
    },
    "keyboard.press": {
      "type": "object",
      "properties": {
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24,
            "pattern": "^[a-zA-Z0-9_+-]+$"
          }
        }
      },
      "required": [
        "keys"
      ],
      "additionalProperties": false
    },
    "performance.observations": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "pointer.click": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16383
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16383
        },
        "button": {
          "type": "string",
          "enum": [
            "left",
            "middle",
            "right"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "hold_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3000
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "pointer.drag": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16383
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16383
        },
        "end_x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16383
        },
        "end_y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16383
        },
        "button": {
          "type": "string",
          "enum": [
            "left",
            "middle",
            "right"
          ]
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3000
        }
      },
      "required": [
        "x",
        "y",
        "end_x",
        "end_y"
      ],
      "additionalProperties": false
    },
    "pointer.move": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16383
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16383
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3000
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "pointer.pinch": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16383
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16383
        },
        "end_x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16383
        },
        "end_y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16383
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3000
        }
      },
      "required": [
        "x",
        "y",
        "end_x",
        "end_y"
      ],
      "additionalProperties": false
    },
    "pointer.scroll": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16383
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16383
        },
        "dx": {
          "type": "integer",
          "minimum": -30,
          "maximum": 30
        },
        "dy": {
          "type": "integer",
          "minimum": -30,
          "maximum": 30
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "recording.start": {
      "type": "object",
      "properties": {
        "duration_seconds": {
          "type": "integer",
          "minimum": 2,
          "maximum": 30
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "recording.stop": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "text.insert": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 8192
        },
        "replace": {
          "type": "boolean"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "trace.start": {
      "type": "object",
      "properties": {
        "capture_text": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "trace.stop": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "visual.sample": {
      "type": "object",
      "properties": {
        "region": {
          "type": "object",
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16383
            },
            "y": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16383
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384
            }
          },
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "visual.wait": {
      "type": "object",
      "properties": {
        "baseline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "condition": {
          "type": "string",
          "enum": [
            "changed",
            "stable"
          ]
        },
        "threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000
        }
      },
      "required": [
        "baseline"
      ],
      "additionalProperties": false
    }
  },
  "limits": {
    "max_batch_steps": 12,
    "replay_window": 64,
    "max_request_bytes": 65536
  }
}
